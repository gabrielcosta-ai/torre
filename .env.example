# Copie para .env.local (dev) ou cadastre na Vercel (Settings > Environment Variables).
# Nunca faça commit de valores reais.

# Postgres (Neon). A integração Vercel Storage injeta DATABASE_URL e POSTGRES_URL; basta uma.
DATABASE_URL=
POSTGRES_URL=

# Host público, sem https:// (ex.: torre.vercel.app). Vira o rpID das passkeys e a origem esperada.
# Em dev: localhost:3000
TORRE_HOST=

# Código do 1º cadastro de passkey. Uso único: depois do 1º aparelho ele deixa de valer.
TORRE_SETUP_CODE=

# Segredo do JWT da sessão (32+ caracteres aleatórios; ex.: openssl rand -base64 48).
TORRE_SESSION_SECRET=

# Token dos agentes (Authorization: Bearer ...). Aleatório e longo (32+ caracteres).
TORRE_AGENT_TOKEN=

# Fuso das datas sem fuso vindas dos agentes (padrão America/Sao_Paulo).
TORRE_TZ=
